# ── Relay (relay/) ─────────────────────────────────────────────────────────────
# The relay only ever handles ciphertext. Copy this file to .env at the repo root.

RELAY_PORT=8787
# Origins allowed to call the relay (the vault and any demo app).
RELAY_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Lighthouse storage. Without a key the relay stores blobs in ./.data/blobs (dev only).
LIGHTHOUSE_API_KEY=
# ipfs-filecoin (default) or ipfs-walrus
LIGHTHOUSE_NETWORK=ipfs-filecoin

# NEAR AI Cloud key (https://cloud.near.ai). The relay adds it to encrypted requests;
# it refuses any chat request whose messages are not end-to-end encrypted.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai

# ── Vault + demo app (apps/*) — Vite reads VITE_* from the repo root .env ─────
VITE_NEAR_NETWORK=testnet
# Registry contract for NEAR wallets. Empty = the deployed one, lighthouse-memory-wallet.testnet.
# (The "Try with a dev key" option always uses a registry in the browser instead.)
VITE_CONTRACT_ID=
VITE_RELAY_URL=http://localhost:8787
VITE_VAULT_URL=http://localhost:5173
VITE_NEARAI_MODEL=z-ai/glm-5.3-flash
VITE_NEARAI_ATTESTATION_URL=https://cloud-api.near.ai
