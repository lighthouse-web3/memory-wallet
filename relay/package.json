{
  "name": "@memory-wallet/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ciphertext-only relay: stores sealed blobs on Lighthouse and forwards end-to-end encrypted requests to NEAR AI with the API key.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../.env src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@lighthouse-ai/core": "0.1.1",
    "@lighthouse-ai/store-lighthouse": "0.1.2",
    "@memory-wallet/core": "*",
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "@noble/curves": "2.4.0"
  }
}
